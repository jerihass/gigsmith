{
  "name": "gigsmith",
  "private": true,
  "version": "0.1.24",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite apps/web --host 127.0.0.1",
    "build": "tsc -b && vite build apps/web && node apps/web/scripts/verify-pwa.mjs",
    "preview": "vite preview apps/web --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:performance-budgets": "node apps/web/scripts/check-performance-budgets.mjs",
    "test:pwa-builds": "node apps/web/scripts/test-pwa-builds.mjs",
    "check:sources": "node scripts/check-source-changes.mjs",
    "refresh:cards": "node scripts/refresh-card-snapshot.mjs",
    "typecheck": "tsc -b",
    "build:ios-engine": "node scripts/build-ios-engine.mjs",
    "check:ios-engine": "node scripts/build-ios-engine.mjs --check",
    "typecheck:ios": "tsc -p apps/ios/tsconfig.json",
    "test:ios": "swift test --package-path apps/ios"
  },
  "dependencies": {
    "lucide-react": "^1.21.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.61.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "0.25.12",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.9"
  }
}
