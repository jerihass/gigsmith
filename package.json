{
  "name": "gigsmith",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite apps/web --host 127.0.0.1",
    "build": "tsc -b && vite build apps/web && node apps/web/scripts/verify-pwa.mjs",
    "preview": "vite preview apps/web --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.61.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5"
  }
}
